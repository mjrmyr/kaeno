;; Rig sandbox profile: confine the worker's shell roughly the way a pod's
;; container filesystem would — its own workspace and home, system binaries,
;; and nothing of the host's user data, temp dirs, or other runs' evidence.
(version 1)
(allow default)
(deny file-read* file-write*
  (subpath "/Users") (subpath "/private/tmp") (subpath "/Volumes")
  (subpath "/opt") (subpath "/private/var") (subpath "/System/Volumes")
  (subpath "/Library") (subpath "/Applications") (subpath "/System/Applications")
  (subpath "/System/iOSSupport") (subpath "/System/DriverKit") (subpath "/System/Cryptexes"))
(allow file-read* file-write* (subpath (param "WS")) (subpath (param "HM")))
(allow file-read* (subpath "/private/var/select"))
(allow file-read-metadata (literal "/private/tmp") (literal "/tmp") (literal "/private/var") (literal "/var"))
