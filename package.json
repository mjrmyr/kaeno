{
  "name": "kaeno",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/host/main.ts",
    "auth": "node --env-file-if-exists=.env scripts/auth.ts",
    "inspect": "node --env-file-if-exists=.env scripts/inspect/main.ts",
    "prepare": "husky",
    "check": "npm run typecheck && npm run lint && npm run architecture:check && npm run format:check",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c .oxlintrc.json src scripts test",
    "architecture:check": "node scripts/check-architecture.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "browser:smoke": "node scripts/browser-runtime-smoke.ts",
    "verify": "npm run check && npm test"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/proper-lockfile": "^4.1.4",
    "husky": "^9.1.7",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/mcp": "0.0.83",
    "microsandbox": "0.7.8",
    "proper-lockfile": "^4.1.2",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  }
}
