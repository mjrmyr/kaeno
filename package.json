{
  "name": "kaeno",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c .oxlintrc.json src test",
    "format": "prettier --write src test README.md package.json",
    "format:check": "prettier --check src test README.md package.json",
    "test": "vitest run",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
