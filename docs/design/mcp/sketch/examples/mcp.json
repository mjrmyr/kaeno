{
  "servers": {
    "linear": {
      "url": "https://mcp.linear.app/mcp",
      "auth": { "oauth": true },
      "tools": {
        "read": ["list_issues", "get_issue", "list_projects"],
        "write": ["create_comment"]
      }
    },
    "sentry": {
      "url": "https://mcp.example-sentry.internal/mcp",
      "auth": { "headerFiles": { "Authorization": "sentry.authorization" } },
      "tools": { "read": ["search_issues", "get_issue_details"] }
    }
  }
}
