{
  "version": 1,
  "servers": {
    "linear": {
      "tools": {
        "create_comment": {
          "description": "Create a comment on a Linear issue.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "issueId": {
                "type": "string"
              },
              "body": {
                "type": "string"
              }
            },
            "required": ["issueId", "body"]
          }
        },
        "get_issue": {
          "description": "Retrieve a Linear issue by id.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            },
            "required": ["id"]
          }
        },
        "list_issues": {
          "description": "\u2026",
          "inputSchema": {
            "type": "object"
          }
        },
        "list_projects": {
          "description": "\u2026",
          "inputSchema": {
            "type": "object"
          }
        }
      },
      "endpoint": "https://mcp.linear.app/mcp"
    },
    "sentry": {
      "tools": {
        "get_issue_details": {
          "description": "\u2026",
          "inputSchema": {
            "type": "object"
          }
        },
        "search_issues": {
          "description": "\u2026",
          "inputSchema": {
            "type": "object"
          }
        },
        "list_events": {
          "description": "Pinned earlier; no longer in mcp.json -> derived tombstone (sentry_list_events stays registered, every call fails without I/O).",
          "inputSchema": {
            "type": "object"
          }
        }
      },
      "endpoint": "https://mcp.example-sentry.internal/mcp"
    },
    "notion": {
      "tools": {
        "search": {
          "description": "Whole server removed from mcp.json -> kaeno-mcp-notion stays installed, all tools retired.",
          "inputSchema": {
            "type": "object"
          }
        }
      },
      "endpoint": "https://mcp.notion.com/mcp"
    }
  }
}
